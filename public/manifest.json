{
  "manifest_version": 3,
  "name": "Klartxt",
  "version": "1.0.0",
  "description": "This Chrome extension analyzes website tracking mechanisms (network requests and cookies) in real time, visualizes them clearly, evaluates compliance with European data protection regulations, and provides actionable, technically grounded recommendations.",
  "action": {
    "default_icon": "img/logo/Klartxt_lm_64.png"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "icons": {
    "32": "img/logo/Klartxt_lm_32.png",
    "64": "img/logo/Klartxt_lm_64.png"
  },
  "permissions": ["webRequest", "cookies", "tabs", "storage", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content-script.ts"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["img/*.png", "fonts/*.ttf", "src/data/trackers/tracker-core.json", "src/data/trackers/tracker-extended.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
