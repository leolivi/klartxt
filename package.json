{
  "name": "Klartxt",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:website": "vite --config vite.website.config.ts",
    "build:website": "vite build --config vite.website.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "tsc -b && vite build --mode e2e",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report e2e/report"
  },
  "dependencies": {
    "@crxjs/vite-plugin": "2.5.0",
    "@radix-ui/react-label": "^2.1.8",
    "@shadcn/ui": "^0.0.4",
    "@tailwindcss/vite": "4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.2.0",
    "lucide-react": "^0.555.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.16.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "4.3.0",
    "tldts": "^7.0.30",
    "vite-plugin-static-copy": "4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.1.40",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "6.0.2",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "8.0.16",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": "24"
  }
}
